# ==============================================================================
# Enterprise Billing Agent Configuration
# Copy this file to config/config.env and adjust values for your GCP environment
# ==============================================================================

# Host GCP Project ID where the central `billing_ent` dataset and BQ CA Agent live
PROJECT_ID="billing-export-123456"

# BigQuery dataset region/location (MUST match the region of all BA export datasets)
BQ_LOCATION="US"

# Central enterprise billing dataset name
ENT_DATASET="billing_ent"

# User privileges table name inside ENT_DATASET
USR_PRV_TABLE="usr-prv"

# List of Billing Account configurations
# Format per entry: "BA_ID:BA_PROJECT_ID:BA_DATASET" (or "BA_PROJECT_ID:BA_DATASET" for auto-discovery)
# Note: BA_ID uses underscores as in BQ export table suffixes (e.g., 012345_6789AB_CDEF01)
BILLING_ACCOUNTS=(
  "012345_6789AB_CDEF01:project-1:billing_ds"
  "ABCDEF_012345_6789AB:project-2:billing"
)

# Recommendations export sources (Format: "REC_PROJECT_ID:REC_DATASET:REC_TABLE")
RECOMMENDATIONS_SOURCES=(
  "org-rec-project:recommendation_us_org:recommendations_export"
  "project-2:billing:recommendations_export"
)

# BigQuery Conversational Analytics (BQ CA) Agent Settings
CA_AGENT_LOCATION="global"
CA_AGENT_ID="enterprise_billing_agent"
CA_AGENT_DISPLAY_NAME="Enterprise Multi-BA FinOps & Billing Agent"
CA_AGENT_DESCRIPTION="Conversational Analytics agent for multi-Billing Account GCP cost, resource usage, pricing, and optimization recommendations."
